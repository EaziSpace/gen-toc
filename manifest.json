{
  "manifest_version": 3,
  "name": "Gen TOC",
  "version": "2.0.0",
  "description": "A slim, searchable table of contents for long pages and AI chats",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["site-rules.js", "content.js"]
    }
  ],
  "commands": {
    "toggle-toc": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "Show or hide the table of contents"
    }
  }
}
